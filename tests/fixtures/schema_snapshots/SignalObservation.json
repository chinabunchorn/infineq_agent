{
  "$defs": {
    "DataOrigin": {
      "description": "Provenance categories visible to operators and evaluators.",
      "enum": [
        "synthetic_replay"
      ],
      "title": "DataOrigin",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Immutable reference to one normalized item of observed evidence.",
      "properties": {
        "evidence_id": {
          "maxLength": 256,
          "pattern": "^ev:[a-z0-9-]+:[a-z0-9_-]+:[a-z0-9_-]+:[a-z0-9_-]+:[a-z0-9_-]+:[a-f0-9]{8}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "title": "Incident Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/DataOrigin"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "incident_id",
        "origin",
        "source",
        "observed_at"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Half-open UTC interval: start inclusive, end exclusive.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A normalized aggregate with its evidence provenance.",
  "properties": {
    "aggregation": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Aggregation",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceRef"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signal": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Signal",
      "type": "string"
    },
    "unit": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "title": "Value",
      "type": "number"
    },
    "window": {
      "$ref": "#/$defs/TimeWindow"
    }
  },
  "required": [
    "signal",
    "value",
    "unit",
    "aggregation",
    "window",
    "evidence"
  ],
  "title": "SignalObservation",
  "type": "object"
}
